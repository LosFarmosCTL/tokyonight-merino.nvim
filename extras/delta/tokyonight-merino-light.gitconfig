[delta]
  minus-style                   = syntax "#f9e2e4"
  minus-non-emph-style          = syntax "#f9e2e4"
  minus-emph-style              = syntax "#e99ca1"
  minus-empty-line-marker-style = syntax "#f9e2e4"
