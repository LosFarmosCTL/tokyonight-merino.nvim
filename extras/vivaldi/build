#!/usr/bin/env python3
"""Package the generated Merino definitions as reproducible Vivaldi ZIPs."""

from pathlib import Path
from zipfile import ZIP_DEFLATED, ZipFile, ZipInfo

directory = Path(__file__).resolve().parent
for path in sorted(directory.glob("tokyonight-merino-*.json")):
    destination = path.with_suffix(".zip")
    entry = ZipInfo("settings.json", date_time=(1980, 1, 1, 0, 0, 0))
    entry.compress_type = ZIP_DEFLATED
    with ZipFile(destination, "w") as archive:
        archive.writestr(entry, path.read_bytes())
    print(destination.name)
