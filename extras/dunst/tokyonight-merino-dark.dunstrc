# TokyoNight Merino colors for dunst
# For more configuration options see https://github.com/dunst-project/dunst/blob/master/dunstrc

[urgency_low]
    background = "#131519"
    foreground = "#e6edf3"
    frame_color = "#e6edf3"

[urgency_normal]
    background = "#0d1117"
    foreground = "#e6edf3"
    frame_color = "#e6edf3"

[urgency_critical]
    background = "#23272d"
    foreground = "#ff7b72"
    frame_color = "#ff7b72"
