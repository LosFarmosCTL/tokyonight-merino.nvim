# Theme: tokyonight-merino-dark
# By: LosFarmosCTL (based on TokyoNight by Folke Lemaitre)

theme[main_bg]="#0d1117"
theme[main_fg]="#e6edf3"

# Title color for boxes
theme[title]="#e6edf3"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e98a4a"

# Selected item in processes box
theme[selected_bg]="#23272d"
theme[selected_fg]="#39c5cf"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#39c5cf"

# Cpu box outline color
theme[cpu_box]="#424549"

# Memory/disks box outline color
theme[mem_box]="#424549"

# Net up/down box outline color
theme[net_box]="#424549"

# Processes box outline color
theme[proc_box]="#424549"

# Box divider line and small boxes line color
theme[div_line]="#424549"

# Temperature graph colors
theme[temp_start]="#a3bd8d"
theme[temp_mid]="#d29922"
theme[temp_end]="#ff7b72"

# CPU graph colors
theme[cpu_start]="#a3bd8d"
theme[cpu_mid]="#d29922"
theme[cpu_end]="#ff7b72"

# Mem/Disk free meter
theme[free_start]="#a3bd8d"
theme[free_mid]="#d29922"
theme[free_end]="#ff7b72"

# Mem/Disk cached meter
theme[cached_start]="#a3bd8d"
theme[cached_mid]="#d29922"
theme[cached_end]="#ff7b72"

# Mem/Disk available meter
theme[available_start]="#a3bd8d"
theme[available_mid]="#d29922"
theme[available_end]="#ff7b72"

# Mem/Disk used meter
theme[used_start]="#a3bd8d"
theme[used_mid]="#d29922"
theme[used_end]="#ff7b72"

# Download graph colors
theme[download_start]="#a3bd8d"
theme[download_mid]="#d29922"
theme[download_end]="#ff7b72"

# Upload graph colors
theme[upload_start]="#a3bd8d"
theme[upload_mid]="#d29922"
theme[upload_end]="#ff7b72"
